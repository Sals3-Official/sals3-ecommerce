# Copy this file to `.env.local` and fill in real values.
# `.env.local` is ignored by git. Never commit real credentials.

# Base URL of the Sals3 Portal service that owns the product catalogue.
# Local default is http://localhost:3001.
SALS3_PORTAL_URL=http://localhost:3001
SALS3_PORTAL_API_URL=http://localhost:3001

# Shared secret for the protected storefront feed and checkout freight quote
# endpoint. Must match sals3-portal SALS3_STOREFRONT_API_TOKEN.
#
# CJ credentials stay in sals3-portal/Vercel only. Ecommerce sends cart lines
# and the buyer address to Portal; Portal resolves seller CJ credentials and
# calls CJ server-side.
SALS3_STOREFRONT_API_TOKEN=

# Shared secret the Portal presents to POST /api/internal/revalidate, which
# expires this storefront's cached product pages the moment a listing is
# published, paused or resumed. Must match sals3-portal
# STOREFRONT_REVALIDATE_SECRET.
#
# Unset means the endpoint refuses every request and the Portal skips calling
# it - product pages then fall back to their own 60s revalidate window, which
# is the behaviour before this existed. Not a failure, just slower.
STOREFRONT_REVALIDATE_SECRET=

# Absolute ecommerce origin used by server-side Stripe Checkout return URLs
# when NEXT_PUBLIC_SITE_URL is not set.
SALS3_ECOMMERCE_BASE_URL=http://localhost:3000

# Firebase Web App config for Google sign-in.
# These values identify the Firebase web app and are safe to expose with the
# NEXT_PUBLIC_ prefix. Restrict the Browser key in Google Cloud.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sals3-b82b6.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sals3-b82b6
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web API key used for the server-side Identity Toolkit calls that verify an
# email/password credential. Optional: falls back to NEXT_PUBLIC_FIREBASE_API_KEY.
# Set it in production when the browser key is restricted by HTTP referrer —
# server-to-server calls send no Referer, so a referrer-restricted key returns
# 403. Point this at a key restricted by API (Identity Toolkit) instead.
FIREBASE_WEB_API_KEY=

# Firebase Admin credentials for server-side session cookies.
# Preferred local setup: set GOOGLE_APPLICATION_CREDENTIALS to the absolute path
# of a service account JSON key kept outside git.
GOOGLE_APPLICATION_CREDENTIALS=

# Hosting-secret fallback when a JSON key file path is not available.
# Keep the private key quoted and preserve \n line breaks.
FIREBASE_PROJECT_ID=sals3-b82b6
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Klaviyo onsite analytics and profile enrichment.
# NEXT_PUBLIC_KLAVIYO_SITE_ID is the safe 6-character public Site ID used by
# the browser loader. KLAVIYO_PRIVATE_API_KEY must stay server-only and should
# have at least profiles:write for /api/klaviyo/profile-sync.
NEXT_PUBLIC_KLAVIYO_SITE_ID=RuXpVU
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_API_REVISION=2026-07-15

# Stripe Embedded Checkout. Publishable key is browser-safe; secret/webhook
# keys are server-only. Do not commit real values.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=

# Cloudflare R2 public base URL seller-uploaded product photos are served
# from (the portal's CLOUDFLARE_R2_PUBLIC_BASE_URL) - an r2.dev subdomain or
# a custom domain bound to the bucket. NEXT_PUBLIC_ because it is a public
# read host inlined into the image allow-list at build time; it is not a
# secret. Unset means seller-uploaded image addresses are dropped at the
# mapper and only CJ-hosted supplier photos render.
NEXT_PUBLIC_R2_IMAGE_BASE_URL=
