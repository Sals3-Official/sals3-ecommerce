# Copy this file to `.env.local` and fill in real values.
# `.env.local` is ignored by git. Never commit real credentials.

# Base URL of the Sals3 Portal service that owns the product catalogue.
# Local default is http://localhost:3001.
SALS3_PORTAL_API_URL=http://localhost:3001

# Shared secret for the protected product feed.
# Must match sals3-portal SALS3_STOREFRONT_API_TOKEN.
SALS3_STOREFRONT_API_TOKEN=

# Firebase Web App config for Google sign-in.
# These values identify the Firebase web app and are safe to expose with the
# NEXT_PUBLIC_ prefix. Restrict the Browser key in Google Cloud.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sals3-b82b6.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sals3-b82b6
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web API key used for the server-side Identity Toolkit calls that verify an
# email/password credential. Optional: falls back to NEXT_PUBLIC_FIREBASE_API_KEY.
# Set it in production when the browser key is restricted by HTTP referrer —
# server-to-server calls send no Referer, so a referrer-restricted key returns
# 403. Point this at a key restricted by API (Identity Toolkit) instead.
FIREBASE_WEB_API_KEY=

# Firebase Admin credentials for server-side session cookies.
# Preferred local setup: set GOOGLE_APPLICATION_CREDENTIALS to the absolute path
# of a service account JSON key kept outside git.
GOOGLE_APPLICATION_CREDENTIALS=

# Hosting-secret fallback when a JSON key file path is not available.
# Keep the private key quoted and preserve \n line breaks.
FIREBASE_PROJECT_ID=sals3-b82b6
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
