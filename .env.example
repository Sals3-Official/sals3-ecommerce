# sals3-portal storefront API (existing).
SALS3_PORTAL_API_URL=http://localhost:3001
SALS3_STOREFRONT_API_TOKEN=

# Catalog Admin API service-to-service auth (phase 1). Shared secret with
# sals3-portal's CATALOG_ADMIN_API_TOKEN — see README.md "Catalog Admin API
# (phase 1)".
CATALOG_ADMIN_API_TOKEN=

# Postgres connection for the Catalog Admin API's candidate persistence.
# Local dev: install PostgreSQL, then create a dedicated least-privilege
# role and database (do not use the postgres superuser here):
#   createuser sals3_app --pwprompt
#   createdb sals3 --owner sals3_app
DATABASE_URL=postgresql://sals3_app:<password>@localhost:5432/sals3?schema=public
