# sals3-portal storefront API (existing).
SALS3_PORTAL_API_URL=http://localhost:3001
SALS3_STOREFRONT_API_TOKEN=

# Catalog Admin API service-to-service auth (phase 1). Shared secret with
# sals3-portal's CATALOG_ADMIN_API_TOKEN — see README.md "Catalog Admin API
# (phase 1)". The Catalog Admin API's own routes currently return
# 503 CATALOG_PERSISTENCE_NOT_CONFIGURED for every request; no database
# exists yet.
CATALOG_ADMIN_API_TOKEN=
