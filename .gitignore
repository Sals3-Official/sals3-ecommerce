# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Obsidian per-person UI state (open tabs, pane layout) - not shared content
docs/.obsidian/workspace.json
docs/.obsidian/workspace-mobile.json

# Claude Code per-person local permission grants - not shared content
.claude/settings.local.json

# safety net: scripts/typecheck-clean-next.mjs's temp swap dir, in case
# it's ever left behind after an interrupted run
.next-typecheck-tmp-*

# Obsidian Local REST API - per-machine secrets, never shared.
# data.json holds the plaintext API key AND the server's RSA private key.
docs/.obsidian/plugins/obsidian-local-rest-api/data.json

# The repository root must not be opened as an Obsidian vault - the vault root
# is docs/. See docs/Wiki/wiki/hot.md, "Repository and vault".
/.obsidian/

# Agent scratch: deck builders, docx/pdf renders, image-edit inputs and their
# outputs. 346 MB and ~8,000 files as of 2026-09-10, none of it vault content.
# Left untracked they are one `git add -A` away from landing in the vault
# repository. Source documents that are worth keeping go to docs/Raw/ instead.
/output/
/outputs/
/tmp/
/deliverables/
/image-edit-inputs/
/.codex-image-assets/
